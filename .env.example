# Server configuration
PORT=4500
SYMPLE_PORT=4500
SYMPLE_SESSION_TTL=-1
SYMPLE_AUTHENTICATION=false
SYMPLE_DYNAMIC_ROOMS=true

# Redis connection (optional - server runs without Redis in single-instance mode)
# SYMPLE_REDIS_URL=redis://localhost:6379
# Or supply host/port separately:
# SYMPLE_REDIS_HOST=localhost
# SYMPLE_REDIS_PORT=6379

# SSL (optional)
# SYMPLE_SSL_ENABLED=false
# SYMPLE_SSL_KEY=/path/to/key.pem
# SYMPLE_SSL_CERT=/path/to/cert.pem
